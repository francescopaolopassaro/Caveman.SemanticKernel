<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Caveman.SemanticKernel</PackageId>
    <Version>1.4.3</Version>
    <Authors>Francesco Paolo Passaro</Authors>
    <Company>Francesco Paolo Passaro</Company>
    <Description>Semantic Kernel plugins for Caveman (NLP Prompt Compressor): prompt token optimization, conversation/agent context tools (summarize, fit-to-budget, memory, focus, token estimate), developer services and on-demand project documentation. Add-on package; references the dependency-free Caveman core. Licensed under the Caveman License (MIT + mandatory attribution to Passaro Francesco Paolo - Digitalsolutions.it).</Description>
    <PackageTags>AI;NLP;LLM;PromptEngineering;SemanticKernel;Agents</PackageTags>
    <RepositoryUrl>https://github.com/francescopaolopassaro/caveman-semantickernel</RepositoryUrl>
    <PackageReleaseNotes>1.4.3: aligned with Caveman core 1.4.3 (now referenced as a NuGet dependency instead of a project reference; 1.4.3 is a corrective re-publish of 1.4.2, which was missing several 1.4.x features). Catches this package up to three core versions of drift (1.3.1 to 1.4.x). TokenOptimizerPlugin.OptimizePrompt now accepts levels 0-5 (adds Statistical and Syntactic). Two new plugins: CavemanRetrievalPlugin (retrieve/retrieve_with_feedback, BM25+ ranking with optional RM3 pseudo-relevance feedback) and CavemanSummarizationPlugin (summarize_text with tfidf/textrank algorithms, summarize_text_topic_aware). CavemanServicesPlugin gains skeletonize_code (strips comments, collapses function bodies to signatures). CavemanConversationPlugin gains check_near_duplicate (SimHash-based near-duplicate detection, complements the existing exact-hash dedup_messages).</PackageReleaseNotes>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>Caveman.SemanticKernel</Title>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Copyright>Copyright (c) 2026 Passaro Francesco Paolo - Digitalsolutions.it</Copyright>
    <PackageProjectUrl>https://github.com/francescopaolopassaro/caveman-semantickernel/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <RootNamespace>caveman.core.SemanticKernel.Plugin</RootNamespace>
    <AssemblyName>Caveman.SemanticKernel</AssemblyName>
    <PackageIcon>caveman-icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

<ItemGroup>
  <None Include="caveman-icon.png" Pack="true" PackagePath="\" />
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.74.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Caveman" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="CHANGELOG.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
